//
// Symbolic links of the stock OS3.0.8.0 vendor partition.
//
// rfs/msm: the remote file system layout tftp_server and rmt_storage serve
// to the ADSP, CDSP, modem (MPSS), SLPI and WPSS of the SoC (mondrian has the
// modem in the SoC; the mdm and apq variants of stock are for other boards).
// firmware/wlan/qca_cld/qca6490: the configuration and MAC address the
// qca_cld3 WLAN driver requests through the firmware loader.

install_symlink {
    name: "vendor_rfs_msm_adsp_hlos",
    soc_specific: true,
    installed_location: "rfs/msm/adsp/hlos",
    symlink_target: "/mnt/vendor/persist/hlos_rfs/shared",
}

install_symlink {
    name: "vendor_rfs_msm_adsp_ramdumps",
    soc_specific: true,
    installed_location: "rfs/msm/adsp/ramdumps",
    symlink_target: "/data/vendor/tombstones/rfs/lpass",
}

install_symlink {
    name: "vendor_rfs_msm_adsp_readonly_firmware",
    soc_specific: true,
    installed_location: "rfs/msm/adsp/readonly/firmware",
    symlink_target: "/vendor/firmware_mnt",
}

